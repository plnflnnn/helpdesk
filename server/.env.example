NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER@localhost:5433/helpdesk
# Used by `npm test`; wiped between tests
TEST_DATABASE_URL=postgresql://USER@localhost:5433/helpdesk_test
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
# Public URL of the React app (trusted origin for auth, base of invite links)
APP_URL=http://localhost:3000

# First admin, created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin

# Enables the "Polish" button on replies (OpenAI via the Vercel AI SDK)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Outbound email. Without both, emails are logged to the console (required in production).
# The from address must be a verified sender (or on an authenticated domain) in SendGrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@example.com
