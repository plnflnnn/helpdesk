// Prisma 7: the connection URL lives in prisma.config.ts, not here.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Better Auth core models. Field names must match what Better Auth expects.
// Tables use snake_case plural names via @@map.

enum Role {
  admin
  agent

  @@map("role")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Exposed to Better Auth as an additional field (not settable through its API).
  role          Role      @default(agent)
  /// Inactive users cannot sign in, and requireAuth rejects their existing sessions.
  active        Boolean   @default(true)
  /// Soft deletion: set when an admin deletes the user. Deleted users are also made inactive and
  /// are hidden from the users list; the row is kept so their tickets and history stay intact.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  /// Tickets this user has claimed or been assigned.
  tickets       Ticket[]
  /// Replies this user sent.
  messages      Message[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  /// Sign-in is email/password only, so every account uses Better Auth's "credential" provider.
  providerId            String    @default("credential")
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Password hash for the email/password ("credential") provider.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Tickets.
// Enum values are declared in their natural order, so sorting by them in Postgres follows it
// (e.g. priority low → normal → high).

enum TicketStatus {
  open
  pending
  resolved
  closed

  @@map("ticket_status")
}

enum TicketCategory {
  general_question
  technical_question
  refund_request
  other

  @@map("ticket_category")
}

enum TicketPriority {
  low
  normal
  high

  @@map("ticket_priority")
}

enum MessageDirection {
  /// From the student.
  inbound
  /// From an agent.
  outbound

  @@map("message_direction")
}

/// Students are identified by email only; created from their first email.
model Student {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@map("students")
}

model Ticket {
  /// Also the ticket number shown to agents and students (e.g. #1042).
  id         Int            @id @default(autoincrement())
  subject    String
  status     TicketStatus   @default(open)
  category   TicketCategory @default(other)
  priority   TicketPriority @default(normal)
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id])
  /// The agent handling the ticket; null while it is in the unassigned queue.
  assigneeId String?
  assignee   User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  messages   Message[]

  @@index([studentId])
  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

/// One email in a ticket's conversation.
model Message {
  id             String           @id @default(uuid())
  ticketId       Int
  ticket         Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  /// The agent who sent an outbound message; null for student messages.
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  bodyText       String
  /// Email `Message-ID` header, used to thread replies.
  emailMessageId String?          @unique
  /// Email `In-Reply-To` header.
  inReplyTo      String?
  createdAt      DateTime         @default(now())

  @@index([ticketId, createdAt])
  @@map("messages")
}
