{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "jest"],
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@generated/*": ["./generated/*"]
    },
    "noEmit": true
  },
  "include": ["src", "prisma", "generated", "prisma.config.ts"]
}
